# dane pobiera skrypt; do repozytorium trafia tylko data/MANIFEST.json z sumami SHA-256
data/*
!data/MANIFEST.json

.venv/
__pycache__/
*.pyc
.pytest_cache/

.idea/
.idea/workspace.xml
.idea/shelf/

# out-of-fold forecasts from tuning (large; regenerated by scripts/tune.py)
results/tuning/oof/
results/**/*.tmp

# trained models (large; SHA-256 in results/final_models.json)
models/

# forecasts (large; SHA-256 in results/forecasts/*_summary.json)
results/forecasts/*.parquet
